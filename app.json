{
  "expo": {
    "name": "HealthFreak",
    "slug": "HealthFreak",
    "scheme": "healthfreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.healthfreak.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HealthFreak needs microphone access to speak with your AI wellness coach.",
        "NSMotionUsageDescription": "HealthFreak tracks your daily steps, distance, and activity goals using your device motion sensors."
      }
    },
    "android": {
      "package": "com.healthfreak.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow HealthFreak to access your microphone for live voice coaching."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HealthFreak to access your camera to scan meals."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow HealthFreak to access your motion sensors to accurately count your daily steps, distance, and activity goals."
        }
      ],
      "expo-asset",
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WaterBottleWidget",
              "label": "HealthFreak Water Tracker",
              "description": "Tap bottle to add 150ml water and track daily hydration with dynamic smiling bottle",
              "minWidth": "120dp",
              "minHeight": "120dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/water_widget_preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "795b6406-b121-4e16-9d07-0fba0525956e"
      }
    }
  }
}
