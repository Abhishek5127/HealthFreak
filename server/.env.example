# ==============================================================================
# HEALTHFREAK VOICE AI — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Keep all secret keys on the backend only. NEVER expose keys in the Expo app!
# ==============================================================================

# Server Port
PORT=3001

# ------------------------------------------------------------------------------
# 1. LIVEKIT CLOUD (WebRTC Real-Time Audio)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LiveKit Outbound SIP Trunk ID for Indian Telephony (Created in LiveKit SIP Settings)
LIVEKIT_SIP_TRUNK_ID=ST_EXOTEL_INDIA_01

# ------------------------------------------------------------------------------
# 2. SARVAM AI & LIVEKIT STANDALONE VOICE AGENT (Indian STT/TTS)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_SPEAKER=shubh
STT_CHOICE=sarvam
TTS_CHOICE=sarvam
STT_LANGUAGE=hi
LLM_MODEL=openai/gpt-4.1-mini

# ------------------------------------------------------------------------------
# 2. VOICE AI MODEL PROVIDER
# Options: 'gemini' (Google Gemini 3.5 Flash-Lite)
# ------------------------------------------------------------------------------
VOICE_PROVIDER=gemini

# OpenAI API Key (Optional / Deprecated)
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini API Key (Gemini 3.5 Flash-Lite)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. EXOTEL TELEPHONY (PSTN Outbound Calls in India)
# ------------------------------------------------------------------------------
EXOTEL_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=+918047100000

# ------------------------------------------------------------------------------
# 4. REDIS (BullMQ Scheduled Calling)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 5. CALLING LIMITS & ADMISSION CONTROL (Free-Tier Protection)
# ------------------------------------------------------------------------------
MAX_CALL_DURATION_SECONDS=600   # 10 minutes maximum per session
MAX_CONCURRENT_CALLS=5          # 5 concurrent sessions on free tier
DAILY_CALL_QUOTA_PER_USER=3     # Max 3 voice check-ins per user per day

# ------------------------------------------------------------------------------
# 6. PRIVACY & DEVELOPMENT MODE
# ------------------------------------------------------------------------------
SYNTHETIC_DATA_MODE=true

# ------------------------------------------------------------------------------
# 7. SUPABASE / POSTGRESQL (50-Entity Relational Database)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://user:pass@host:6543/postgres
